# Always check for a newer version of the page and code (cheap: unchanged files return 304)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache
/*.css
  Cache-Control: no-cache
# Photos and icons rarely change: cache for a week
/img/*
  Cache-Control: public, max-age=604800
/icons/*
  Cache-Control: public, max-age=604800
