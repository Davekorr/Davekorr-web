# Every page: ask AI systems not to train on or mine this site (copyright reserved)
/*
  X-Robots-Tag: noai, noimageai
  tdm-reservation: 1
  tdm-policy: https://davekorr.com/copyright

# Always check for a newer version of the page and code (cheap: unchanged files return 304)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache
/*.css
  Cache-Control: no-cache
# Photos and icons rarely change: cache for a week
/img/*
  Cache-Control: public, max-age=604800
/icons/*
  Cache-Control: public, max-age=604800

# Contact card: open/import as a contact on iPhone, Android and PC
/dave-korr.vcf
  Content-Type: text/vcard; charset=utf-8
  Content-Disposition: inline; filename="Dave Korr.vcf"
